{
  "version": 2,
  "routes": [
    { "src": "/api/data", "dest": "api/data.js" },
    { "src": "/styles.css", "dest": "/css/styles.css" },
    { "src": "/app.js", "dest": "/js/app.js" },
    { "src": "/fonts/(.*)", "dest": "/fonts/$1", "headers": { "cacheControl": "public, max-age=31536000, immutable" } },
    { "src": "/logo.webp", "dest": "/logo.webp", "headers": { "cacheControl": "public, max-age=86400" } },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
